{
  "name": "@ado-open-in-excel/excel-addin",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack serve --mode development",
    "dev-server": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest.dev.xml",
    "start:nodebug": "office-addin-debugging start manifest.dev.xml --no-debug",
    "stop": "office-addin-debugging stop manifest.dev.xml",
    "sideload": "office-addin-dev-settings sideload manifest.xml desktop",
    "unsideload": "office-addin-dev-settings unregister manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml && office-addin-manifest validate manifest.dev.xml",
    "lint": "npm run validate"
  },
  "config": {
    "app_to_debug": "excel",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3001
  },
  "dependencies": {
    "@ado-open-in-excel/shared": "*",
    "@azure/msal-browser": "^4.26.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@types/office-js": "^1.0.559",
    "@types/office-runtime": "^1.0.35",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^13.0.0",
    "core-js": "^3.45.0",
    "html-webpack-plugin": "^5.6.3",
    "office-addin-debugging": "^6.0.3",
    "office-addin-dev-certs": "^2.0.3",
    "office-addin-manifest": "^2.0.3",
    "regenerator-runtime": "^0.14.1",
    "source-map-loader": "^5.0.0",
    "typescript": "^5.9.2",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  }
}
